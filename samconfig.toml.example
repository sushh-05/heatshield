version = 0.1

[default.deploy.parameters]
stack_name = "heatshield-dev"
resolve_s3 = true
s3_prefix = "heatshield-dev"
region = "ap-south-1"
confirm_changeset = true
capabilities = "CAPABILITY_IAM"
# Example: parameter_overrides = "AllowedOrigin=https://app.example.com ClerkAuthorizedParties=https://app.example.com TelegramBotUsername=YourCrewBot"
parameter_overrides = ""
image_repositories = []

