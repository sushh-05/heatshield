# Local settings for the API (backend/server.py reads this file). Nothing here is needed for demo mode.
AWS_REGION=ap-south-1
AWS_DEFAULT_REGION=ap-south-1
# Leave unset to keep data in memory. Set it only to use a real DynamoDB table.
# TABLE_NAME=HeatShield

HEATSHIELD_DEMO=true
# Local dev: allow supervisor actions without sign-in. Never set this on a public deployment.
HEATSHIELD_OPEN_ACCESS=true
SUPERVISOR_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
# Comma-separated origins allowed to present Clerk tokens, e.g. https://app.example.com
CLERK_AUTHORIZED_PARTIES=
# The dashboard's origin for CORS; * allows any.
ALLOWED_ORIGIN=*
# Public URL of this API, used in email check-in links.
PUBLIC_API_URL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
DISCORD_PUBLIC_KEY=
DISCORD_WEBHOOK_SECRET=
DISCORD_WEBHOOK_URL=
DISCORD_INVITE_URL=
SLACK_WEBHOOK_URL=
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_RECIPIENTS=
# Signs email check-in links. Falls back to the Gmail app password when unset.
CHECKIN_LINK_SECRET=

USE_BEDROCK=false
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
